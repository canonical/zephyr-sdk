{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^VERSION$/"],
      "matchStrings": [
        "(?<currentValue>[0-9.]+(?:-[a-zA-Z0-9.]+)?)"
      ],
      "depNameTemplate": "zephyrproject-rtos/zephyr",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    }
  ],
  "baseBranchPatterns": [
    "4.1",
    "4.2",
    "4.3",
    "4.4"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["zephyrproject-rtos/zephyr"],
      "matchBaseBranches": ["4.1"],
      "allowedVersions": "/^4\\.1\\./"
    },
    {
      "matchPackageNames": ["zephyrproject-rtos/zephyr"],
      "matchBaseBranches": ["4.2"],
      "allowedVersions": "/^4\\.2\\./"
    },
    {
      "matchPackageNames": ["zephyrproject-rtos/zephyr"],
      "matchBaseBranches": ["4.3"],
      "allowedVersions": "/^4\\.3\\./"
    },
    {
      "matchPackageNames": ["zephyrproject-rtos/zephyr"],
      "matchBaseBranches": ["4.4"],
      "allowedVersions": "/^4\\.4\\./"
    }
  ]
}
